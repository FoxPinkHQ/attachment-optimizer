<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="attachment_optimizer_migration_queue_confirm_form" model="ir.ui.view">
        <field name="name">attachment.migration.queue.confirm.form</field>
        <field name="model">attachment.migration.queue.confirm</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle"/>
                    You are about to create a migration queue.
                    This will analyze attachments and prepare them for upload to S3.
                </div>
                <group>
                    <group>
                        <field name="count" string="Attachments to process"/>
                    </group>
                    <group>
                        <field name="total_size" string="Estimated total size"/>
                        <field name="estimated_duration" string="Estimated duration"/>
                    </group>
                </group>
                <field name="candidate_ids" invisible="1"/>
                <footer>
                    <button name="action_confirm" string="Create Queue" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="attachment_optimizer_migration_queue_confirm_action" model="ir.actions.act_window">
        <field name="name">Confirm Migration Queue</field>
        <field name="res_model">attachment.migration.queue.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
