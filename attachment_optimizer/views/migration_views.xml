<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- ── List View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_migration_operation_tree" model="ir.ui.view">
        <field name="name">attachment.migration.operation.tree</field>
        <field name="model">attachment.migration.operation</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="attachment_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'queued'"
                       decoration-info="state in ('uploading','uploaded')"
                       decoration-success="state in ('verified','finalized')"
                       decoration-danger="state == 'failed'"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="duration_display"/>
                <field name="mapping_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_migration_operation_form" model="ir.ui.view">
        <field name="name">attachment.migration.operation.form</field>
        <field name="model">attachment.migration.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_upload" string="Upload to S3" type="object"
                            class="btn-primary"
                            invisible="state != 'queued'"/>
                    <button name="action_retry" string="Retry" type="object"
                            invisible="state != 'failed'" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachment" type="object"
                                class="oe_stat_button" icon="fa-file">
                            View Attachment
                        </button>
                    </div>

                    <notebook>
                        <!-- ═══ Overview Tab ═══ -->
                        <page string="Overview">
                            <group>
                                <group>
                                    <field name="attachment_id" readonly="1"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'queued'"
                                           decoration-info="state in ('uploading','uploaded')"
                                           decoration-success="state in ('verified','finalized')"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="mapping_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="queued_at"/>
                                    <field name="started_at"/>
                                    <field name="completed_at"/>
                                    <field name="duration_display"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══ Timeline Tab ═══ -->
                        <page string="Timeline">
                            <p class="text-muted">
                                <i class="fa fa-info-circle"/>
                                Events sourced from audit trail.
                            </p>
                            <field name="audit_log_ids" nolabel="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="action" widget="badge"/>
                                    <field name="user_id"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'success'"
                                           decoration-danger="result == 'failure'"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══ Errors Tab ═══ -->
                        <page string="Errors" invisible="state not in ('failed', 'verification_failed')">
                            <div class="alert alert-danger" role="alert" invisible="not error_message">
                                <h4><i class="fa fa-exclamation-circle"/> Migration failed</h4>
                                <p class="mb-0"><field name="error_message" nolabel="1"/></p>
                            </div>
                            <div class="alert alert-info" role="alert" invisible="error_message">
                                <p class="mb-0"><i class="fa fa-check-circle"/> No errors detected.</p>
                            </div>
                            <group string="Suggested Actions">
                                <div class="o_suggested_actions">
                                    <button name="action_view_config" string="Check Configuration" type="object"
                                            class="btn btn-secondary"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────── -->
    <record id="attachment_optimizer_migration_operation_action" model="ir.actions.act_window">
        <field name="name">Migration Operations</field>
        <field name="res_model">attachment.migration.operation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'import': False}</field>
        <field name="help">
            No migration operations yet. Click the Action button (top-left toolbar) then
            "Create Migration Queue" to scan attachments and build the migration queue.
        </field>
    </record>

    <!-- ── Server Actions ─────────────────────────────────── -->
    <record id="action_analyze_and_queue_server" model="ir.actions.server">
        <field name="name">Create Migration Queue</field>
        <field name="model_id" ref="model_attachment_migration_operation"/>
        <field name="binding_model_id" ref="model_attachment_migration_operation"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = env['attachment.migration.operation'].action_analyze_and_queue()</field>
    </record>

    <record id="action_upload_server" model="ir.actions.server">
        <field name="name">Start Upload</field>
        <field name="model_id" ref="model_attachment_migration_operation"/>
        <field name="binding_model_id" ref="model_attachment_migration_operation"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
records = env['attachment.migration.operation'].browse(env.context.get('active_ids', []))
if records:
    action = records.action_upload()
else:
    action = env['attachment.migration.operation'].action_upload()
</field>
    </record>

    <!-- ── Menu ───────────────────────────────────────────── -->
    <menuitem id="attachment_optimizer_migration_operation_menu"
              name="Migration Operations"
              parent="storage_optimization_menu"
              action="attachment_optimizer_migration_operation_action"
              sequence="20"/>
    </data>
</odoo>
