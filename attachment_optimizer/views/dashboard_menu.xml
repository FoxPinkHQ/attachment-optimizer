<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Dashboard Client Action (OWL widget) -->
    <record id="attachment_optimizer_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">attachment_optimizer.dashboard_action</field>
    </record>

    <menuitem id="attachment_optimizer_dashboard_menu"
              name="Dashboard"
              parent="storage_optimization_menu"
              action="attachment_optimizer_dashboard_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="5"/>

    <record id="attachment_optimizer_settings_action" model="ir.actions.act_window">
        <field name="name">Attachment Optimizer Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'attachment_optimizer'}</field>
    </record>

    <menuitem id="attachment_optimizer_settings_menu"
              name="Configuration"
              parent="storage_optimization_menu"
              action="attachment_optimizer_settings_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="40"/>
    </data>
</odoo>
