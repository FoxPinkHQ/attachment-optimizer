<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_optimizer_config_settings" model="ir.ui.view">
        <field name="name">attachment.optimizer.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Attachment Optimizer" string="Attachment Optimizer" data-key="attachment_optimizer">
                    <h2>S3 Storage</h2>
                    <div class="row mt16 o_settings_container" name="s3_storage_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="s3_bucket_setting"><div class="o_setting_right_pane">
                            <label for="s3_bucket" string="Bucket"/><div class="text-muted">Existing bucket used to store migrated attachments. The module does not create buckets automatically.</div>
                            <field name="s3_bucket" placeholder="my-bucket"/><div class="text-muted">Enter an existing bucket name, for example <code>attachments</code>.</div>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="s3_region_setting"><div class="o_setting_right_pane">
                            <label for="s3_region" string="Region"/><div class="text-muted">AWS region. For most MinIO installations, use us-east-1.</div><field name="s3_region" placeholder="us-east-1"/>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="s3_endpoint_setting"><div class="o_setting_right_pane">
                            <label for="s3_endpoint_url" string="Endpoint URL"/><div class="text-muted">Leave empty for Amazon S3. For MinIO or another compatible provider, enter its API endpoint.</div>
                            <field name="s3_endpoint_url" placeholder="https://s3.example.com"/><div class="text-muted">Docker users: <code>localhost</code> points to the Odoo container, not the storage server.</div>
                        </div></div>
                    </div>
                    <h2>Credentials</h2>
                    <div class="row mt16 o_settings_container" name="s3_credentials_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="s3_access_key_setting"><div class="o_setting_right_pane">
                            <label for="s3_access_key_id" string="Access Key"/><div class="text-muted">Access key with read, write, list, and delete permissions on the selected bucket.</div><field name="s3_access_key_id" placeholder="Access key ID"/>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="s3_secret_key_setting"><div class="o_setting_right_pane">
                            <label for="s3_secret_access_key" string="Secret Key"/><div class="text-muted">S3 Secret Access Key</div><field name="s3_secret_access_key" password="true"/>
                            <div class="text-muted">Save the settings, then test bucket access before analyzing storage.</div><div class="content-group mt16"><button string="Test Connection" name="action_test_s3_connection" type="object" class="btn btn-secondary"/></div>
                        </div></div>
                    </div>
                    <h2>Auto-Recovery</h2>
                    <div class="row mt16 o_settings_container" name="s3_recovery_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="recovery_enabled_setting"><div class="o_setting_left_pane"><field name="recovery_enabled"/></div><div class="o_setting_right_pane">
                            <label for="recovery_enabled" string="Enable Auto-Recovery"/><div class="text-muted">Automatically recover stuck/failed operations via cron</div>
                        </div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="recovery_limit_setting"><div class="o_setting_right_pane">
                            <label for="recovery_limit" string="Recovery Batch Limit"/><div class="text-muted">Max operations to recover per cron run</div><field name="recovery_limit"/>
                        </div></div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>