<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_optimizer_config_settings" model="ir.ui.view">
        <field name="name">attachment.optimizer.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Attachment Optimizer">
                <div class="oe_title">
                    <h1>Attachment Optimizer</h1>
                </div>
                <group string="S3 Storage" name="s3">
                    <group>
                        <field name="s3_bucket" placeholder="my-bucket"/>
                        <field name="s3_region" placeholder="us-east-1"/>
                        <field name="s3_endpoint_url" placeholder="http://localhost:9000"/>
                    </group>
                    <group>
                        <field name="s3_access_key_id" placeholder="minioadmin"/>
                        <field name="s3_secret_access_key" password="true"/>
                    </group>
                </group>
                <footer>
                    <button string="Test Connection"
                            name="action_test_s3_connection"
                            type="object"
                            class="btn-primary"/>
                    <button string="Save"
                            special="save"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attachment_optimizer_config_settings" model="ir.actions.act_window">
        <field name="name">Attachment Optimizer</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_attachment_optimizer_config_settings"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_attachment_optimizer_settings"
              name="Attachment Optimizer"
              parent="base.menu_config"
              action="action_attachment_optimizer_config_settings"
              sequence="50"/>
</odoo>