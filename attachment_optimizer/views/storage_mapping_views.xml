<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_storage_mapping_tree" model="ir.ui.view">
        <field name="name">attachment.storage.mapping.tree</field>
        <field name="model">attachment.storage.mapping</field>
        <field name="arch" type="xml">
            <list create="false" edit="true" delete="false">
                <field name="attachment_id"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('verified','finalized')"
                       decoration-warning="status == 'pending'"
                       decoration-info="status in ('uploading','uploaded')"
                       decoration-danger="status in ('failed','verification_failed')"/>
                <field name="s3_bucket" optional="show"/>
                <field name="verification_timestamp" optional="show"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_storage_mapping_form" model="ir.ui.view">
        <field name="name">attachment.storage.mapping.form</field>
        <field name="model">attachment.storage.mapping</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachment" type="object"
                                class="oe_stat_button" icon="fa-file">
                            View Attachment
                        </button>
                        <button name="action_view_audit" type="object"
                                class="oe_stat_button" icon="fa-history">
                            View Audit
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="attachment_id" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status in ('verified','finalized')"
                                   decoration-warning="status == 'pending'"
                                   decoration-info="status in ('uploading','uploaded')"
                                   decoration-danger="status in ('failed','verification_failed')"/>
                            <field name="s3_bucket" string="Storage Location" readonly="1"/>
                            <field name="s3_key" string="S3 Object Key" readonly="1"/>
                        </group>
                        <group>
                            <field name="s3_region" readonly="1"/>
                            <field name="checksum_sha256" string="Checksum SHA-256" readonly="1"/>
                            <field name="verification_timestamp" readonly="1"/>
                        </group>
                    </group>
                    <group string="Metadata">
                        <field name="create_date" string="Created" readonly="1"/>
                        <field name="write_date" string="Last Updated" readonly="1"/>
                        <field name="error_message" readonly="1" invisible="not error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────── -->
    <record id="attachment_optimizer_storage_mapping_search" model="ir.ui.view">
        <field name="name">attachment.storage.mapping.search</field>
        <field name="model">attachment.storage.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="attachment_id"/>
                <field name="s3_bucket"/>
                <field name="status"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────── -->
    <record id="attachment_optimizer_storage_mapping_action" model="ir.actions.act_window">
        <field name="name">Managed Attachments</field>
        <field name="res_model">attachment.storage.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help">
            Manage attachment storage mapping records.
        </field>
        <field name="context">{'create': False, 'import': False}</field>
    </record>

    <menuitem id="storage_optimization_menu"
              name="Storage Optimization"
              sequence="10"/>

    <menuitem id="attachment_storage_mapping_menu"
              name="Managed Attachments"
              parent="storage_optimization_menu"
              action="attachment_optimizer_storage_mapping_action"
              sequence="10"/>
</odoo>
