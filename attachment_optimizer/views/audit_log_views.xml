<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_audit_log_tree" model="ir.ui.view">
        <field name="name">attachment.audit.log.tree</field>
        <field name="model">attachment.audit.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                                    <field name="action" widget="badge"
                       decoration-success="action in ('verify','finalize','verify_finalize','migration_queue_created')"
                                            decoration-info="action in ('analyze','queue','claim','heartbeat')"
                                            decoration-warning="action in ('upload','retry','recover')"
                                            decoration-danger="action == 'cancel'"/>
                <field name="attachment_id"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'success'"
                       decoration-danger="result == 'failure'"/>
                <field name="reason" optional="show"/>
                <field name="rule" optional="show"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View (read-only) ─────────────────────────── -->
    <record id="attachment_optimizer_audit_log_form" model="ir.ui.view">
        <field name="name">attachment.audit.log.form</field>
        <field name="model">attachment.audit.log</field>
        <field name="arch" type="xml">
            <form edit="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-lock"/>
                        <strong>READ ONLY</strong>
                        — This record is part of the immutable audit trail and cannot be modified or deleted.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachment" type="object"
                                class="oe_stat_button" icon="fa-file"
                                invisible="not attachment_id">
                            View Attachment
                        </button>
                        <button name="action_view_operation" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not operation_id">
                            View Operation
                        </button>
                    </div>
                    <notebook>
                        <page string="Event Details">
                            <group>
                                <group>
                <field name="action" widget="badge"
                                           decoration-success="action in ('verify','finalize','verify_finalize','migration_queue_created')"
                       decoration-info="action in ('analyze','queue','claim','heartbeat')"
                       decoration-warning="action in ('upload','retry','recover')"
                       decoration-danger="action == 'cancel'"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'success'"
                                           decoration-danger="result == 'failure'"/>
                                    <field name="reason" invisible="not reason"/>
                                    <field name="create_date" string="Timestamp"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="attachment_id"/>
                                    <field name="res_model" string="Related Model"/>
                                </group>
                            </group>
                        </page>
                        <page string="Error Context"
                              invisible="not error_message">
                            <field name="error_message" nolabel="1"
                                   class="font-monospace bg-light p-3 rounded"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────── -->
    <record id="attachment_optimizer_audit_log_search" model="ir.ui.view">
        <field name="name">attachment.audit.log.search</field>
        <field name="model">attachment.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="action"/>
                <field name="attachment_id"/>
                <field name="result"/>
                <separator/>
                <filter name="success" string="Success" domain="[('result', '=', 'success')]"/>
                <filter name="failure" string="Failure" domain="[('result', '=', 'failure')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_by_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action (now includes form) ─────────────────────── -->
    <record id="attachment_optimizer_audit_log_action" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">attachment.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'import': False}</field>
        <field name="help">
            Audit trail of all storage migration actions.
            Records are read-only and cannot be modified or deleted.
        </field>
    </record>

    <!-- ── Menu ───────────────────────────────────────────── -->
    <menuitem id="attachment_optimizer_audit_log_menu"
              name="Audit Logs"
              parent="storage_optimization_menu"
              action="attachment_optimizer_audit_log_action"
              sequence="30"/>
</odoo>
