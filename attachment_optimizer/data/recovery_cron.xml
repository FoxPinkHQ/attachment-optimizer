<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- System parameters for Recovery Engine configuration -->
        <record id="attachment_storage_recovery_enabled" model="ir.config_parameter">
            <field name="key">attachment_storage.recovery.enabled</field>
            <field name="value">True</field>
        </record>

        <record id="attachment_storage_recovery_interval" model="ir.config_parameter">
            <field name="key">attachment_storage.recovery.interval</field>
            <field name="value">300</field>
        </record>

        <record id="attachment_storage_recovery_limit" model="ir.config_parameter">
            <field name="key">attachment_storage.recovery.limit</field>
            <field name="value">500</field>
        </record>

        <!-- Cron job — calls RecoveryEngine; logic lives in the service, not here -->
        <record id="ir_cron_recovery_engine" model="ir.cron">
            <field name="name">Storage Migration — Recovery Engine</field>
            <field name="model_id" ref="model_attachment_migration_operation"/>
            <field name="state">code</field>
            <field name="code">model.action_recovery()</field>
            <field name="interval_number" eval="5"/>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
